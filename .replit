modules = ["nodejs-20", "web", "python-3.11"]
run = "git pull origin main --ff-only 2>/dev/null || true && npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["run"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5099
externalPort = 4200

[[ports]]
localPort = 5151
externalPort = 3001

[[ports]]
localPort = 5163
externalPort = 3003

[[ports]]
localPort = 5904
externalPort = 3000
  
[env]
PORT = "5000"

[deployment]
deploymentTarget = "reserved-vm"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git pull origin main --ff-only 2>/dev/null || true && npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_object_storage:2.0.0", "javascript_openai_ai_integrations:2.0.0", "resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 480000

[userenv]

[userenv.shared]
WAITLIST_MODE = "false"
COMPANY_OS_MONTHLY_BUDGET_AED = "400"
USD_TO_AED_RATE = "3.6725"
BOOTSTRAP_ADMIN_EMAIL = "thandolwenkosimceeyah@gmail.com"
ADMIN_EMAIL_ALLOWLIST = "thandolwenkosimceeyah@gmail.com,thando@bareter.com"
PRIVATE_OBJECT_DIR = "replit-objstore-7e5628f2-57c3-4e06-a847-99cef1d8fb27/.private"
DIDIT_KYC_WORKFLOW_ID = "e686a4fc-af82-4ccd-93f9-6b5a807a1735"
DIDIT_KYB_WORKFLOW_ID = "1dc44918-7efd-406a-9e5a-9a923c91931e"

[userenv.production]
PUBLIC_APP_URL = "https://bareter.com "

[objectStorage]
defaultBucketID = "replit-objstore-7e5628f2-57c3-4e06-a847-99cef1d8fb27"
